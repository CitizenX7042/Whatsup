TRANSPORT=mock

# Azure SQL
AZURE_SQL_SERVER=yourserver.database.windows.net
AZURE_SQL_DATABASE=yourdb
AZURE_SQL_USER=youruser
AZURE_SQL_PASSWORD=yourpassword
AZURE_SQL_PORT=1433
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false
AZURE_SQL_CONNECTION_TIMEOUT=30000
AZURE_SQL_REQUEST_TIMEOUT=15000

# Azure OpenAI (set both to use real LLM instead of mock)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_TIMEOUT_MS=60000
AZURE_OPENAI_MAX_RETRIES=3

# Azure OpenAI pricing (USD per 1M tokens, for cost estimation)
AZURE_OPENAI_INPUT_PRICE_PER_1M=0.15
AZURE_OPENAI_OUTPUT_PRICE_PER_1M=0.60
AZURE_OPENAI_CACHED_INPUT_PRICE_PER_1M=0.075

MEMORY_DIR=./data/memory
AUTH_DIR=./data/auth
LOG_DIR=./data/logs
LOG_LEVEL=info

ALLOWED_COMMANDS=ls,cat,date,pwd,whoami,echo
ALLOWED_PATHS=./data/memory